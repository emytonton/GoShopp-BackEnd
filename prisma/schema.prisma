generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Store {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @unique @db.ObjectId
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@map("stores")
}
